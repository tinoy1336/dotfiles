# 6i. stale-but-tempting superseded copies
/.local/bin/screenshot-region.bak-predegenerate

# 6j. user data, media and other work trees at the home root
/aur/
/dev/
/downloads/
/documents/
/desktop/
/Music/
/Pictures/
/pictures/
/wallpapers/
/Notes/
/ZCodeProject/

# --- 7. OPTIONAL: promote these if they are part of the restore point --------
# Each line is a deliberate exception. The four root ags-overnight-* report
# files, handoffs/ and files-redesign/ are working documents and are left
# excluded by /* on purpose.
# !/handoffs/
# !/wallpapers/
# !/documents/
# !/*.md
