/.config/user-dirs.locale
/.config/welcome_news_latest_date_file
/.config/trashrc
/.config/baloofilerc
# note CONTENT (a sticky-notes app's stored text and window geometry), not tool
# configuration. Ruled out of scope with ~/.local/share/notes/; to promote both,
# add the re-include chain for each.
/.config/sticky/
# enable-symlinks recreated by `systemctl --user enable`, with absolute targets
# outside the work tree (one points into /usr/lib/systemd/user)
/.config/systemd/user/*.wants/

# 6g. KDE / Plasma leftovers — excluded pending a plasma-removal decision
/.config/kdeglobals
/.config/kglobalshortcutsrc
/.config/kcminputrc
