# =============================================================================
# $HOME dotfiles repo — work tree /home/tinoy, git metadata ~/.dotfiles.git
#
# WHITELIST STYLE. Nothing in $HOME is tracked unless it is re-included below.
# The file is protective: nothing is staged, no repository is initialised by it.
#
# Verify before a stage:
#   dotfiles check-ignore -v <path>   # names the pattern hiding a path
#   dotfiles add -n -A | head         # dry run: what would actually be added
#
# RULE FOR FUTURE EDITS: never add a `!` line for a cache, an application
# profile, a credential store or a transcript directory. Re-include the
# narrowest path that carries user intent.
# =============================================================================

# --- 1. root whitelist: ignore every home-root entry --------------------------
/*
# /backups/ holds repository history whose contents were deliberately removed
# from the tracked set. The rule above is the only thing hiding it, so it must
# never be re-included: a `!/backups/` line here publishes that history in the
# next commit.

# --- 2. shell, editor, identity, home-root scripts (hand-written) ------------
!/.zshrc
!/.zshenv
!/.bashrc
!/.bash_profile
!/.bash_logout
!/.tmux.conf
!/.gitconfig
# this file: without it a clone or a restore has no ignore rule at all, and the
# next blanket `git add` there is the unprotected sweep this file's whitelist
# exists to prevent
!/.gitignore
!/.gtkrc-2.0
# the repository's own surface: the CI workflows and the scripts they run, the
# README, the contribution notes, the licence, and the installer's root entry
# point, which forwards to the script under .github/scripts/
!/.github/
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/install.sh
# NOT re-included, so ignored by /*: .zsh_history .bash_history
# .python_history .node_repl_history .viminfo .wget-hsts .pulse-cookie
# .zcompdump-*  (histories and completion dumps)

# --- 3. ~/.config: re-include the dir, hide its children, re-include intent ---
!/.config/
/.config/*
# the extracted project's LIVE CONFIG — nine flat files, the machine's values.
# The shell's own tree is a separate repository and is not re-included.
!/.config/tinshell/
# hand-written tool and desktop config
!/.config/hypr/
!/.config/kitty/
!/.config/haruna/
!/.config/mpv/
!/.config/rofi/
!/.config/swaync/
!/.config/yad/
!/.config/htop/
!/.config/yay/
!/.config/easyeffects/
!/.config/tlpui/
!/.config/qalculate/
!/.config/xdg-desktop-portal/
!/.config/wireplumber/
# the rendered per-machine fragment: WirePlumber reads *.conf, so the tracked
# template beside it (*.in) is inert and the machine's own value lives in the
# rendered file, which git does not carry
/.config/wireplumber/wireplumber.conf.d/*-local.conf
!/.config/pi-caveman/
!/.config/gtk-3.0/
!/.config/gtk-4.0/
!/.config/systemd/
# per-machine host declarations: the units a machine enables and the
# root-scoped files it installs, applied by ~/.local/bin/host-apply. The
# declaration is tracked under the placeholder name HOSTNAME; host-apply opens
# the directory named after the machine, which is a local symlink to that
# directory — the name is the machine's, so it is not tracked, and enablement
# links are gitignored too: this file is the record of which units a rebuild
# has to re-enable
!/.config/hosts/
/.config/hosts/*
!/.config/hosts/HOSTNAME/
!/.config/environment.d/
!/.config/autostart/
!/.config/git/
# hand-written single files
!/.config/mimeapps.list
!/.config/user-dirs.dirs
!/.config/pavucontrol.ini
!/.config/kwalletrc
!/.config/youtube-music-flags.conf

# --- 4. ~/.local: only bin/ (user-owned scripts) ------------------------------
!/.local/
/.local/*
!/.local/bin/
/.local/bin/__pycache__/
# these three are absolute symlinks into the shell's own tree; that tree's
# setup.sh recreates them, so the links themselves are not committed
/.local/bin/tinshell-host
/.local/bin/tinshell-route
/.local/bin/tinshell-mode

# --- 5. hygiene inside every re-included tree ---------------------------------
**/node_modules/
__pycache__/
*.pyc
*.swp
*.swo
*~
*.tmp
*.log
*.bak
*.bak-*
.ags-*
.Trash-*

# --- 6. HARD DENIES — redundant with /* on purpose: they must survive a future
#        edit that re-includes a parent. DO NOT REMOVE. ------------------------
