/.config/ags-backup-popover/
/.config/ags-archive-internal-panel/

# 6f. machine-generated application state
/.local/state/
/.local/share/
/.local/pi/
/.local/lib/
/.config/dconf/
/.config/session/
/.config/menus/
/.config/waybar/
/.config/kate/
