# 6c. generated caches, package managers, language toolchains
/.cache/
/.cargo/
/.rustup/
/.npm/
/.bun/
/.yarn/
/.dotnet/
/.nuget/
/.electron-gyp/
/.vscode/
/.vscode-shared/
/.biome/
/.semgrep/
/.opengrep/
