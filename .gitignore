# 6j. user data, media and other work trees at the home root
/aur/
/dev/
# the pre-rename backup of the old shell tree — its count is machine state, so
# no part of it travels; every ags-* link inside it is dangling
/migration-backup-2026-09-23/
/downloads/
/documents/
/desktop/
/Music/
/Pictures/
/pictures/
/wallpapers/
/Notes/
/ZCodeProject/

# --- 6k. the pi agent environment: the configuration in, the state out -------
# The pi tree is deny-listed at 6a and 6b and stays deny-listed: what follows
# re-includes the narrowest paths that carry the agent's configuration — the
# settings, the model table, the locally authored extensions,
# the skills, the patch set and its scripts. The deny lines are repeated here on
# purpose: gitignore resolves a path by the LAST matching pattern, so a
# re-include of a parent would otherwise sweep a credential, a transcript or a
# package install tree back in.
!/.pi/
/.pi/*
!/.pi/settings.json
!/.pi/agent/
/.pi/agent/*
!/.pi/agent/settings.json
!/.pi/agent/models.json
# a search-provider key, the agent's auth store, machine trust, crash logs, the
# generated model catalogue and the glyph dataset a package install writes
/.pi/web-search.json
/.pi/agent/auth.json
/.pi/agent/trust.json
/.pi/agent/models-store.json
/.pi/agent/data/
/.pi/agent/pi-crash.log
/.pi/agent/pi-tui-crash.log
/.pi/agent/run-history.jsonl
/.pi/agent/missions/
/.pi/agent/sessions/
# the package install tree is restored by an install, not by a checkout, and the
# ignore file pi writes in the directory beside it hides the two manifests as
# well; carrying those would need `dotfiles add -f` past that file, the one
# direction this whitelist exists to avoid, so the versions stay pi's record
/.pi/agent/npm/
# the canon store holds the rules a session loads, but every running session
# rewrites it as it works: carrying it would put that churn in every diff the
# machine produces, so the directory is denied outright
/.pi/agent/canon/
# the intercom configuration, not the runtime directory beside it
!/.pi/agent/intercom/
/.pi/agent/intercom/*
!/.pi/agent/intercom/config.json
# the locally authored extension sources and the spec sheets that describe them
!/.pi/agent/extensions/
/.pi/agent/extensions/*
!/.pi/agent/extensions/AGENTS.md
!/.pi/agent/extensions/lib/
!/.pi/agent/extensions/fleet/
!/.pi/agent/extensions/io-guard/
!/.pi/agent/extensions/subagent/
/.pi/agent/extensions/node_modules/
# the tariff table carries this machine's billed rates and its own header says
# it must not be published; lib/tariff.ts holds no rate of its own
/.pi/agent/tariff.json
/.pi/agent/extensions/tariff.json
# the skills a session loads; the foreman directory holds a retired skill's
# research reports rather than a skill the agent runs
!/.pi/agent/skills/
/.pi/agent/skills/foreman/
# the generated theme the settings select: the file is rendered from the house
# palette, so a restore needs it; the directory is re-included only so the file
# line below can reach it, and any other file written there stays ignored
!/.pi/agent/themes/
/.pi/agent/themes/*
!/.pi/agent/themes/house.json
# the patch set — the patches, the runner, the doctor and the self test —
# without the apply log, its lock, the upstream copies the runner keeps and the
# two patch replies a package bump superseded
!/.pi/agent/patches/
/.pi/agent/patches/apply.log
/.pi/agent/patches/.apply.lock
/.pi/agent/patches/**/pre-patch/
/.pi/agent/patches/**/*.pre-rebase
# the harnesses, without a run's output
!/.pi/agent/test-rigs/
/.pi/agent/test-rigs/**/runs/
/.pi/agent/test-rigs/**/live/evidence/

# --- 6l. the foreman crew's protocol documents --------------------------------
# Two files that define how a worker behaves, kept so another machine runs the
# same crew. Everything else under .local/pi/foreman/ is the record of a run —
# handoffs, reports, item and roster files, the worker sandboxes — and stays out.
!/.local/pi/
/.local/pi/*
!/.local/pi/foreman/
/.local/pi/foreman/*
!/.local/pi/foreman/worker.md
!/.local/pi/foreman/clockout.md

# --- 7. the files this home renders from the house palette --------------------
# A carrier is a template module beside the file it produces, plus the renderer's
# record of that file. .github/scripts/palette-targets.json is the list of them
# and .github/scripts/palette-check.sh re-renders every entry, so what is tracked
# here and what the gate checks cannot drift apart. Each carrier takes the
# narrowest lines that reach its three files.
#
# .config/hypr, .config/kitty, .config/gtk-3.0 and .config/gtk-4.0 are re-included
# wholesale in section 3, so the carriers that live there need nothing here.
!/.config/git/colors.inc
!/.config/git/colors.inc.record.json
!/.config/git/colors.template.ts
!/.config/tmux/
/.config/tmux/*
!/.config/tmux/colors.conf
!/.config/tmux/colors.conf.record.json
!/.config/tmux/colors.template.ts
!/.config/zsh/
/.config/zsh/*
!/.config/zsh/house-colors.sh
!/.config/zsh/house-colors.sh.record.json
!/.config/zsh/house-colors.template.ts
!/.config/gtkrc.house
!/.config/gtkrc.house.record.json
!/.config/gtkrc.house.template.ts
!/.config/house-palette/
/.config/house-palette/*
!/.config/house-palette/kdeglobals.colours.ini
!/.config/house-palette/kdeglobals.colours.ini.record.json
!/.config/house-palette/kdeglobals.colours.template.ts
# the client's profile is denied wholesale in 6d — it holds that account's token
# and its cache — and only the QuickCSS file the client watches is re-included
!/.config/vesktop/
/.config/vesktop/*
!/.config/vesktop/settings/
/.config/vesktop/settings/*
!/.config/vesktop/settings/quickCss.css
!/.config/vesktop/settings/quickCss.css.record.json
!/.config/vesktop/settings/quickCss.template.ts
# the player's profile is denied wholesale too: its config.json holds the
# scrobbling session. The theme it mounts is already re-included by extension,
# so its template and its record are named here and nothing else opens
!/.config/YouTube Music/themes/house.template.ts
!/.config/YouTube Music/themes/house.css.record.json
# the agent theme directory: the generated theme is re-included above, and its
# template and record are named beside it
!/.pi/agent/themes/house.template.ts
!/.pi/agent/themes/house.json.record.json
