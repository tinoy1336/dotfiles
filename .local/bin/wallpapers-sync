#!/usr/bin/env bash
# On-demand sync of ~/wallpapers <-> Proton Drive /my-files/Wallpapers.
# Uses the official proton-drive CLI (auth session in the login keyring,
# ch.proton.drive/drive-sdk-cli) — no background daemon involved.
#
# Usage:
#   wallpapers-sync pull [--apply]   Cloud -> local (cloud is source of truth;
#                                    merges dirs, replaces changed files,
#                                    flattens the nested Wallpapers/ dir).
#                                    --apply sets a random wallpaper after.
#   wallpapers-sync push             Local -> cloud. Uploads new/changed files
#                                    (same content auto-skipped). Never deletes
#                                    remote files — deletions don't propagate.
#   wallpapers-sync apply            Set a random wallpaper from ~/wallpapers
#                                    (awww fade) + sync it to the greeter.
#   wallpapers-sync apply-greeter    Apply the greeter's synced wallpaper (the
#                                    image the login screen showed) so the
#                                    post-login handoff fades seamlessly.
set -uo pipefail

dest="$HOME/wallpapers"
remote="/my-files/Wallpapers"
transition_type="fade"
transition_duration=2

log() { printf '%s\n' "$*"; }
die() { printf 'wallpapers-sync: %s\n' "$*" >&2; exit 1; }

wait_for_network() {
    for _ in $(seq 1 12); do
        if proton-drive filesystem list /my-files >/dev/null 2>&1; then
            return 0
        fi
        sleep 5
    done
    die "proton-drive CLI unavailable or not authenticated (login keyring session missing?)"
}

pull() {
    mkdir -p "$dest"
    wait_for_network
    log "Pulling $remote -> $dest ..."
    proton-drive filesystem download -c merge -f replace "$remote" "$dest" || die "download failed"
    if [ -d "$dest/Wallpapers" ]; then
        find "$dest/Wallpapers" -mindepth 1 -maxdepth 1 -exec mv -t "$dest" {} +
        rmdir "$dest/Wallpapers" 2>/dev/null || true
    fi
    log "Pull complete."
}

push() {
    shopt -s nullglob
    local files=("$dest"/*)
    shopt -u nullglob
    [ ${#files[@]} -eq 0 ] && die "nothing in $dest to push"
    wait_for_network
    log "Pushing $dest -> $remote ..."
    proton-drive filesystem upload -c merge -f replace "${files[@]}" "$remote" || die "upload failed"
    log "Push complete."
}

# Core apply: awww-fade a specific image, retrying until the daemon accepts.
apply_file() {
    local pick="$1"
    for _ in $(seq 1 10); do
        if awww img "$pick" --transition-type "$transition_type" --transition-duration "$transition_duration" 2>/dev/null; then
            log "Applied: $pick"
            return 0
        fi
        sleep 2
    done
    die "awww-daemon unreachable"
}

# The login wallpaper the greeter paints before login (greeter-owned, mode
# 666, so the session user writes it without root).
# TINSHELL_GREETER_WALLPAPER names another path for a caller that must not touch
# the live login input.
GREETER_WALLPAPER="${TINSHELL_GREETER_WALLPAPER:-/etc/greetd/tinshell-greeter/wallpaper.png}"

# Publish $1 as the login wallpaper. The copy failing leaves the PREVIOUS image
# at the login screen, so the failure is named on stderr and the caller exits
# non-zero instead of reporting a sync that did not happen. A machine with no
# greeter deployment has no login wallpaper to refresh — that is stated once
# and is not a failure.
publish_greeter_wallpaper() {
    local src="$1" err
    if [ ! -d "$(dirname "$GREETER_WALLPAPER")" ]; then
        log "greeter wallpaper: no deployment at $(dirname "$GREETER_WALLPAPER") — not synced"
        return 0
    fi
    if [ ! -r "$src" ]; then
        printf 'wallpapers-sync: greeter wallpaper NOT synced — unreadable source: %s (login keeps %s)\n' \
            "$src" "$(basename "$GREETER_WALLPAPER")" >&2
        return 1
    fi
    if ! err="$(cp -f "$src" "$GREETER_WALLPAPER" 2>&1)"; then
        printf 'wallpapers-sync: greeter wallpaper NOT synced — %s NOT replaced (%s); login keeps the previous image\n' \
            "$GREETER_WALLPAPER" "${err:-cp failed}" >&2
        return 1
    fi
    log "greeter wallpaper: $GREETER_WALLPAPER <- $src"
    return 0
}

apply() {
    shopt -s nullglob
    local walls=("$dest"/*.png)
    shopt -u nullglob
    [ ${#walls[@]} -eq 0 ] && die "no .png files in $dest"
    # Never pick the image already on screen (when alternatives exist).
    local current
    current="$(awww query 2>/dev/null | sed -n 's/.*currently displaying: image: //p' | head -n1)"
    if [ -n "$current" ] && [ ${#walls[@]} -gt 1 ]; then
        local others=()
        local w
        for w in "${walls[@]}"; do
            [ "$w" != "$current" ] && others+=("$w")
        done
        [ ${#others[@]} -gt 0 ] && walls=("${others[@]}")
    fi
    local pick="${walls[$((RANDOM % ${#walls[@]}))]}"
    apply_file "$pick"
    publish_greeter_wallpaper "$pick" || exit 1
}

# Login handoff: apply the SAME image the greeter showed (the synced greeter
# wallpaper) so the post-login transition is wallpaper -> same wallpaper, not
# a visible swap to a random image. The 10-min rotation timer randomizes
# later.
apply_greeter() {
    local pick="$GREETER_WALLPAPER"
    [ -f "$pick" ] || die "greeter wallpaper missing: $pick"
    # Instant (no fade) + fast retry: the login handoff must paint the SAME
    # wallpaper the greeter showed as quickly as possible (the daemon may
    # still be starting when hyprland.lua calls us).
    for _ in $(seq 1 50); do
        if awww img "$pick" --transition-type none 2>/dev/null; then
            log "Applied: $pick"
            return 0
        fi
        sleep 0.2
    done
    die "awww-daemon unreachable"
}

case "${1:-}" in
    pull)  shift; pull; [ "${1:-}" = "--apply" ] && apply ;;
    push)  push ;;
    apply) apply ;;
    apply-greeter) apply_greeter ;;
    *)     die "usage: wallpapers-sync {pull [--apply]|push|apply|apply-greeter}" ;;
esac
