#!/usr/bin/env node
// Sends one intercom message to a pi session (by id prefix), waking it.
// Usage: pi-wake <session-id-prefix> [message]
import net from "net";
import os from "os";
import fs from "fs";
import path from "path";

const PREFIX = process.argv[2];
const TEXT = process.argv[3] || "keepalive ping from manager watcher";
if (!PREFIX) {
  console.error("usage: pi-wake <session-id-prefix> [message]");
  process.exit(1);
}

const SOCK = path.join(process.env.HOME, ".pi/agent/intercom/broker.sock");

function writeMessage(sock, msg) {
  const json = JSON.stringify(msg);
  const buf = Buffer.allocUnsafe(4 + Buffer.byteLength(json));
  buf.writeUInt32BE(Buffer.byteLength(json), 0);
  buf.write(json, 4);
  sock.write(buf);
}

const reader = () => {
  let header = Buffer.alloc(0);
  return (data, onMsg) => {
    let d = data;
    while (d.length > 0) {
      if (header.length < 4) {
        const need = 4 - header.length;
        header = Buffer.concat([header, d.subarray(0, need)]);
        d = d.subarray(need);
        if (header.length < 4) return;
      }
      const len = header.readUInt32BE(0);
      if (d.length < len) return;
      onMsg(JSON.parse(d.subarray(0, len).toString()));
      header = Buffer.alloc(0);
      d = d.subarray(len);
    }
  };
};

const sock = net.connect(SOCK);
const feed = reader();
let stage = "list";
const sessionIdOf = (m) => m.session?.id ?? "";

const pendingList = [];
sock.on("data", (data) => {
  feed(data, (msg) => {
    if (msg.type === "sessions") {
      const target = msg.sessions.find((s) => s.id.startsWith(PREFIX));
      if (!target) {
        console.error(`no session matching prefix ${PREFIX}`);
        sock.destroy();
        process.exit(2);
      }
      stage = "send";
      writeMessage(sock, {
        type: "send",
        to: target.id,
        message: {
          id: `wake-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
          timestamp: Date.now(),
          content: { text: TEXT },
        },
      });
    } else if (msg.type === "registered") {
      writeMessage(sock, { type: "list", requestId: "list1" });
    } else if (msg.type === "delivered") {
      console.log(`delivered ${msg.messageId}`);
      writeMessage(sock, { type: "unregister" });
      sock.destroy();
      process.exit(0);
    } else if (msg.type === "error") {
      console.error(`broker error: ${msg.error}`);
      sock.destroy();
      process.exit(3);
    }
  });
});

sock.on("connect", () => {
  writeMessage(sock, {
    type: "register",
    session: {
      name: "manager-keepalive",
      cwd: "/home/tinoy",
      model: "script",
      pid: process.pid,
      startedAt: Date.now(),
      lastActivity: Date.now(),
    },
  });
});

setTimeout(() => {
  console.error("timeout");
  sock.destroy();
  process.exit(4);
}, 10000);
